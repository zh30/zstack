{
  "schemaVersion": 1,
  "host": "Codex CLI",
  "hostVersion": "codex-cli 0.146.0",
  "model": "gpt-5.6-sol",
  "reasoningEffort": "low",
  "sandbox": "read-only",
  "approvalPolicy": "never",
  "ephemeralSession": true,
  "promptTransport": "generated prompt through stdin",
  "jobs": 4,
  "timeoutSecondsPerCase": 180,
  "descriptionCharacterLimit": null,
  "wrapper": "auto",
  "candidateRotation": "full manifest index modulo candidate count",
  "cases": [
    "market-vague",
    "market-public",
    "discovery-plan",
    "discovery-debrief",
    "landing-waitlist",
    "landing-metrics",
    "prd-notes",
    "prd-rewrite",
    "seo-live-url",
    "seo-prd-map",
    "none-code-fix",
    "none-architecture",
    "boundary-real-interviews",
    "boundary-public-research",
    "boundary-waitlist-demand",
    "zh-market-public",
    "zh-discovery-plan",
    "zh-landing-waitlist",
    "zh-prd-notes",
    "zh-seo-live-url",
    "zh-none-code-fix",
    "zh-none-architecture",
    "zh-boundary-real-interviews",
    "zh-boundary-public-research",
    "zh-boundary-waitlist-demand"
  ],
  "dryRun": false,
  "ignoreUserConfig": true,
  "ignoreRules": true,
  "isolatedHostHome": true,
  "ambientDesktopContextDisabled": [
    "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
    "CODEX_PERMISSION_PROFILE",
    "CODEX_THREAD_ID"
  ],
  "disabledFeatures": [
    "multi_agent",
    "multi_agent_v2",
    "browser_use",
    "in_app_browser",
    "computer_use",
    "apps",
    "skill_search"
  ]
}
