  "subagents": false,
  "jobs": 2,
  "cases": [
    "discovery-five-interviews",
    "smoke-complete-pack",
    "prd-evidence-rich-mvp",
    "seo-supplied-search-notes"
  ],
  "dryRun": false,
  "grading": "not performed by runner",
  "ignoreUserConfig": true,
  "ignoreRules": true,
  "disabledFeatures": [
    "multi_agent",
    "multi_agent_v2",
    "browser_use",
    "in_app_browser",
    "computer_use",
    "apps",
    "skill_search"
  ]
}
