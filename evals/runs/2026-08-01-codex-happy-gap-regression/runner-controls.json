{
  "schemaVersion": 1,
  "host": "Codex CLI",
  "hostVersion": "codex-cli 0.146.0",
  "model": "gpt-5.6-sol",
  "reasoningEffort": "medium",
  "sandbox": "read-only",
  "approvalPolicy": "never",
  "ephemeralSession": true,
  "promptTransport": "generated prompt through stdin",
  "skillSource": "exact copied source snapshots",
