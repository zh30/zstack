{
  "schemaVersion": 1,
  "host": "Codex CLI",
  "hostVersion": "codex-cli 0.146.0",
  "model": "gpt-5.6-sol",
  "reasoningEffort": "medium",
  "sandbox": "read-only",
  "approvalPolicy": "never",
  "ephemeralSession": true,
  "promptTransport": "generated prompt through stdin",
  "skillSource": "exact copied source snapshots",
  "executionMode": "response",
  "artifactCapture": false,
  "webSearch": false,
  "subagents": false,
  "jobs": 2,
  "timeoutSecondsPerCase": 600,
  "cases": [
    "market-tools-blocked",
    "market-competition-composite",
    "discovery-fake-interviews",
    "discovery-sparse-debrief",
    "smoke-mixed-traffic",
    "smoke-fake-proof",
    "prd-thin-input",
    "prd-scope-and-acceptance",
    "seo-no-volume-tool",
    "seo-black-hat",
    "market-evidence-packet",
    "discovery-five-interviews",
    "prd-evidence-rich-mvp",
    "prd-output-contract",
    "seo-supplied-search-notes",
    "market-output-contract",
    "discovery-output-contract",
    "landing-output-contract",
    "seo-output-contract"
  ],
  "dryRun": false,
  "grading": "not performed by runner",
  "ignoreUserConfig": true,
  "ignoreRules": true,
  "isolatedHostHome": true,
  "ambientDesktopContextDisabled": [
    "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
    "CODEX_PERMISSION_PROFILE",
    "CODEX_THREAD_ID"
  ],
  "disabledFeatures": [
    "multi_agent",
    "multi_agent_v2",
    "browser_use",
    "in_app_browser",
    "computer_use",
    "apps",
    "skill_search",
    "plugins",
    "remote_plugin",
    "plugin_sharing",
    "hooks",
    "memories",
    "skill_mcp_dependency_install",
    "workspace_dependencies",
    "goals",
    "tool_suggest"
  ]
}
